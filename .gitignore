# Sensitive data and private student sheets
*.xlsx
*.csv

# Uploaded files and cached downloads (keep directory structure)
portal/app/storage/files/*
!portal/app/storage/files/.gitkeep
!portal/app/storage/files/test.pdf
portal/app/storage/exports/*
!portal/app/storage/exports/.gitkeep
!portal/app/storage/.htaccess

# Environment and secrets
portal/app/.env
extras/ocr-ilovepdf/.env

# Scratch scripts and temporary files
scratch/
__pycache__/
*.pyc
*.log
*.tmp
.DS_Store
Thumbs.db
