# ---------------------------------------------------------------------------------------------
# ScholarshipHive Processing Portal - server settings
# Copy this file to "portal/app/.env" (same folder) and fill in the values.
# This folder is never served to browsers. Never put these keys in JavaScript or HTML.
# ---------------------------------------------------------------------------------------------

# iLovePDF API keys (OCR). Get them at https://www.iloveapi.com -> Console -> Projects -> your project.
# The secret key signs every request on the server; the public key identifies the project.
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=

# Where iLovePDF processes the files: eu, us, fr, de, pl, in or sg. Leave as eu if unsure.
ILOVEPDF_REGION=eu

# OCR languages (iLovePDF codes, comma separated). eng = English. Add urd for Urdu, e.g. eng,urd
ILOVEPDF_OCR_LANGUAGES=eng
